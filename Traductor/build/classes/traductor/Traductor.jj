options {
    STATIC = false;
}

PARSER_BEGIN(Traductor)

package traductor;

import java.io.*;
import java.util.*;

/**
 * Traductor.jj
 * ------------
 * Extiende la gramática original de Analizador.jj: SIGUE reconociendo y
 * validando el mismo código C# (mismos tokens, mismas reglas, mismo
 * análisis léxico/semántico impreso por consola), pero además cada regla
 * ahora CONSTRUYE Y REGRESA un Nodo del AST en vez de ser "void".
 *
 * Ese árbol (Nodo "programa") es lo que luego recorren GeneradorPython y
 * GeneradorJavaScript para producir el código traducido.
 *
 * Qué cambié respecto a Analizador.jj:
 *   - Cada "void regla()" pasó a ser "Nodo regla()" y termina con
 *     "{ return nodo; }".
 *   - Se agregaron variables locales "Nodo n = new Nodo(\"tipo\")" y
 *     llamadas a n.agregar(...) / n.atributo(...) para ir armando el árbol.
 *   - mostrarToken(t) y regla(...) del original se conservan tal cual,
 *     así que la salida de consola con el detalle léxico/sintáctico sigue
 *     funcionando igual que antes.
 */
public class Traductor {

    public static void regla(String r) {
        System.out.println("Regla: " + r);
    }

    public static void mostrarToken(Token t) {
        String palabra = t.image.toLowerCase();
        System.out.println("----------------------");
        if (Diccionario.mapa.containsKey(palabra)) {
            PalabraInfo info = Diccionario.mapa.get(palabra);
            System.out.println("Token: " + info.token);
            System.out.println("Expresion Regular: " + info.expresion);
            System.out.println("Lexema: " + t.image);
            if (info.lenguaje != null && !info.lenguaje.isEmpty())
                System.out.println("Lenguaje: " + info.lenguaje);
            if (info.clasificacion != null && !info.clasificacion.isEmpty())
                System.out.println("Clasificacion: " + info.clasificacion);
            if (info.funcion != null && !info.funcion.isEmpty())
                System.out.println("Funcion: " + info.funcion);
        } else {
            if (t.kind == IDENTIFICADOR) {
                System.out.println("Token: IDENTIFICADOR");
                System.out.println("Lexema: " + t.image);
            } else if (t.kind == NUMERO) {
                System.out.println("Token: NUMERO");
                System.out.println("Lexema: " + t.image);
            } else if (t.kind == DECIMAL) {
                System.out.println("Token: DECIMAL");
                System.out.println("Lexema: " + t.image);
            } else if (t.kind == CADENA) {
                System.out.println("Token: CADENA");
                System.out.println("Lexema: " + t.image);
            } else {
                System.out.println("Token: " + t.image);
                System.out.println("Lexema: " + t.image);
            }
        }
    }
}

PARSER_END(Traductor)

// ======================================================
// SKIP - Espacios en blanco (igual que el original)
// ======================================================
SKIP : { " " | "\t" | "\n" | "\r" }

// ======================================================
// TOKENS
// ======================================================
TOKEN : {
    < IF: "if" >
|   < ELSE: "else" >
|   < TRY: "try" >
|   < CATCH: "catch" >
|   < FINALLY: "finally" >
|   < THROW: "throw" >
|   < WHILE: "while" >
|   < FOR: "for" >
|   < DO: "do" >
|   < BREAK: "break" >
|   < CONTINUE: "continue" >
|   < RETURN: "return" >
|   < SWITCH: "switch" >
|   < CASE: "case" >
|   < DEFAULT_KW: "default" >
|   < TRUE: "true" >
|   < FALSE: "false" >
|   < NULL: "null" >
|   < PRINT: "print" >
|   < PRINTLN: "println" >
|   < CONSOLE: "Console" >
|   < WRITELINE: "WriteLine" >
|   < READLINE: "ReadLine" >
|   < FOREACH: "foreach" >
|   < IN: "in" >
|   < INT: "int" >
|   < NEW: "new" >
|   < BOOL: "bool" >
|   < BOOLEAN: "boolean" >
|   < STRING: "string" >
|   < CHAR: "char" >
|   < DOUBLE: "double" >
|   < FLOAT: "float" >
|   < LONG: "long" >
|   < SHORT: "short" >
|   < BYTE: "byte" >
|   <COMENTARIO_LINEA: "//" (~["\n", "\r"])* >
|   <COMENTARIO_BLOQUE: "/*" (~["*"] | "*" ~["/"])* "*/" >
}

TOKEN : {
    < MENOR_IGUAL: "<=" >
|   < MAYOR_IGUAL: ">=" >
|   < IGUALDAD: "==" >
|   < DIFERENTE: "!=" >
|   < MENOR: "<" >
|   < MAYOR: ">" >
|   < SUMA_ASIGNACION: "+=">
|   < RESTA_ASIGNACION: "-=">
|   < SUMA: "+" >
|   < RESTA: "-" >
|   < MULT: "*" >
|   < DIV: "/" >
|   < MOD: "%" >
|   < ASIGNACION: "=" >
|   < INCREMENTO: "++" >
|   < DECREMENTO: "--" >
|   < AND_LOGICO: "&&" >
|   < OR_LOGICO: "||" >
|   < NOT_LOGICO: "!" >
}

TOKEN : {
    < PARENTESIS_IZQ: "(" >
|   < PARENTESIS_DER: ")" >
|   < LLAVE_IZQ: "{" >
|   < LLAVE_DER: "}" >
|   < CORCHETE_IZQ: "[" >
|   < CORCHETE_DER: "]" >
|   < PUNTO_Y_COMA: ";" >
|   < DOS_PUNTOS: ":" >
|   < COMA: "," >
|   < PUNTO: "." >
}

TOKEN : {
    < DECIMAL: (["0"-"9"])+ "." (["0"-"9"])+ >
|   < NUMERO: (["0"-"9"])+ >
|   < CADENA: "\"" (~["\""])* "\"" | "\'" (~["\'"])* "\'" >
|   < IDENTIFICADOR: (["a"-"z","A"-"Z"]) (["a"-"z","A"-"Z","0"-"9"])* >
}

// ======================================================
// GRAMATICA - cada regla ahora construye y regresa un Nodo
// ======================================================

Nodo programa() :
{ Nodo raiz = new Nodo("programa"); Nodo hijo; }
{
    ( hijo=instruccion() { raiz.agregar(hijo); } )+ <EOF>
    { return raiz; }
}

Nodo instruccion() :
{ Nodo n; }
{
    (
          LOOKAHEAD(2) n=comentario()
        | LOOKAHEAD(2) n=declaracionVariable()
        | LOOKAHEAD(6) n=copiarArreglo()
        | LOOKAHEAD(4) n=operacionArreglo()
        | LOOKAHEAD(2) n=asignacion()
        | LOOKAHEAD(2) n=incrementoDecremento()
        | LOOKAHEAD(2) n=condicion()
        | LOOKAHEAD(2) n=manejoExcepciones()
        | LOOKAHEAD(2) n=throwInstruccion()
        | LOOKAHEAD(2) n=cicloMientras()
        | LOOKAHEAD(2) n=cicloPara()
        | LOOKAHEAD(2) n=cicloDoWhile()
        | LOOKAHEAD(2) n=cicloForeach()
        | LOOKAHEAD(2) n=estructuraSwitch()
        | LOOKAHEAD(2) n=escritura()
        | LOOKAHEAD(2) n=breakInstruccion()
        | LOOKAHEAD(2) n=continueInstruccion()
        | LOOKAHEAD(2) n=returnInstruccion()
        | LOOKAHEAD(2) n=bloque()
    )
    {
        if (n != null) {
            n.atributo(
                "lineaFin",
                String.valueOf(getToken(0).endLine)
            );
        }
        return n;
    }
}

Nodo comentario() :
{
    Token t;
    Nodo n = new Nodo("comentario");
}
{
    (
        t=<COMENTARIO_LINEA>
      |
        t=<COMENTARIO_BLOQUE>
    )
    {
        n.valor = t.image;
        n.atributo(
            "lineaInicio",
            String.valueOf(t.beginLine)
        );
        return n;
    }
}

// ------------------------------------------------------
// DECLARACION DE VARIABLES
// ------------------------------------------------------

Nodo declaracionVariable() :
{
    Token t;
    String tipoDato = "";
    Nodo lista = new Nodo("declaracionesMultiples");
    Nodo variable;
}
{
    { regla("declaracionVariable -> tipo listaVariables puntocoma"); }

    (
          t=<INT>     { mostrarToken(t); tipoDato = "int"; }
        | t=<BOOL>    { mostrarToken(t); tipoDato = "bool"; }
        | t=<BOOLEAN> { mostrarToken(t); tipoDato = "boolean"; }
        | t=<STRING>  { mostrarToken(t); tipoDato = "string"; }
        | t=<CHAR>    { mostrarToken(t); tipoDato = "char"; }
        | t=<DOUBLE>  { mostrarToken(t); tipoDato = "double"; }
        | t=<FLOAT>   { mostrarToken(t); tipoDato = "float"; }
        | t=<LONG>    { mostrarToken(t); tipoDato = "long"; }
        | t=<SHORT>   { mostrarToken(t); tipoDato = "short"; }
        | t=<BYTE>    { mostrarToken(t); tipoDato = "byte"; }
    )

    [
        t=<CORCHETE_IZQ> { mostrarToken(t); }
        t=<CORCHETE_DER> { mostrarToken(t); }
        { tipoDato = tipoDato + "[]"; }
    ]

    variable=declaracionVariableElemento(tipoDato) {
        lista.agregar(variable);
    }

    (
        t=<COMA> { mostrarToken(t); }
        variable=declaracionVariableElemento(tipoDato) {
            lista.agregar(variable);
        }
    )*

    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    { return lista; }
}

Nodo declaracionVariableElemento(String tipoDato) :
{ Token t; Nodo n = new Nodo("declaracionVariable"); Nodo exp; }
{
    t=<IDENTIFICADOR> {
        mostrarToken(t);
        n.valor = t.image;
        n.atributo("tipoDato", tipoDato);

        Semantico.declararVariable(t.image, tipoDato);
    }

    [
        t=<ASIGNACION> { mostrarToken(t); }
        exp=expresion() { n.agregar(exp); }
    ]

    { return n; }
}

Nodo declaracionVariableFor() :
{
    Token t;
    String tipoDato = "";
    Nodo lista = new Nodo("declaracionesMultiples");
    Nodo variable;
}
{
    (
          t=<INT>     { mostrarToken(t); tipoDato = "int"; }
        | t=<BOOL>    { mostrarToken(t); tipoDato = "bool"; }
        | t=<BOOLEAN> { mostrarToken(t); tipoDato = "boolean"; }
        | t=<STRING>  { mostrarToken(t); tipoDato = "string"; }
        | t=<CHAR>    { mostrarToken(t); tipoDato = "char"; }
        | t=<DOUBLE>  { mostrarToken(t); tipoDato = "double"; }
        | t=<FLOAT>   { mostrarToken(t); tipoDato = "float"; }
        | t=<LONG>    { mostrarToken(t); tipoDato = "long"; }
        | t=<SHORT>   { mostrarToken(t); tipoDato = "short"; }
        | t=<BYTE>    { mostrarToken(t); tipoDato = "byte"; }
    )

    [
        t=<CORCHETE_IZQ> { mostrarToken(t); }
        t=<CORCHETE_DER> { mostrarToken(t); }
        { tipoDato = tipoDato + "[]"; }
    ]

    variable=declaracionVariableElemento(tipoDato) {
        lista.agregar(variable);
    }

    (
        t=<COMA> { mostrarToken(t); }
        variable=declaracionVariableElemento(tipoDato) {
            lista.agregar(variable);
        }
    )*

    { return lista; }
}

// ------------------------------------------------------
// ASIGNACION
// ------------------------------------------------------
Nodo asignacion() :
{
    Token t;
    Nodo n = new Nodo("asignacion");
    Nodo indice = null;
    Nodo exp;
}
{
    { regla("asignacion -> identificador indiceOpcional operador expresion puntocoma"); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        n.valor = t.image;
    }

    [
        t=<CORCHETE_IZQ> { mostrarToken(t); }
        indice=expresion()
        t=<CORCHETE_DER> { mostrarToken(t); }
        {
            n.atributo("asignacionArreglo", "true");
            n.agregar(indice);
        }
    ]

    (
        t=<ASIGNACION>
        {
            mostrarToken(t);
            n.atributo("operadorAsignacion", "=");
        }
      | t=<SUMA_ASIGNACION>
        {
            mostrarToken(t);
            n.atributo("operadorAsignacion", "+=");
        }
      | t=<RESTA_ASIGNACION>
        {
            mostrarToken(t);
            n.atributo("operadorAsignacion", "-=");
        }
    )

    exp=expresion()
    { n.agregar(exp); }

    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    { return n; }
}

// ------------------------------------------------------
// INCREMENTO / DECREMENTO
// ------------------------------------------------------
Nodo incrementoDecremento() :
{ Token t; Nodo n = new Nodo("incrementoDecremento"); }
{
    t=<IDENTIFICADOR> {
        mostrarToken(t);
        n.valor = t.image;
    }
    (
        t=<INCREMENTO> {
            mostrarToken(t);
            n.atributo("operador", "++");
        }
      |
        t=<DECREMENTO> {
            mostrarToken(t);
            n.atributo("operador", "--");
        }
    )
    t=<PUNTO_Y_COMA> {
        mostrarToken(t);
        return n;
    }
}

// ------------------------------------------------------
// IF - ELSE
// ------------------------------------------------------
Nodo condicion() :
{ Token t; Nodo n = new Nodo("condicion"); Nodo cond, bIf, bElse; }
{
    { regla("condicion -> if ( expresionLogica ) bloque ( else bloque )?"); }
    t=<IF> { mostrarToken(t); }
    t=<PARENTESIS_IZQ> { mostrarToken(t); }
    cond=expresionLogica() { n.agregar(cond); }
    t=<PARENTESIS_DER> { mostrarToken(t); }
    bIf=bloque() { n.agregar(bIf); }
    [
        t=<ELSE> { mostrarToken(t); n.atributo("tieneElse", "true"); }
        bElse=bloque() { n.agregar(bElse); }
    ]
    { return n; }
}


 // ------------------------------------------------------
 // EXCEPCIONES: TRY - CATCH - FINALLY
 // ------------------------------------------------------

Nodo manejoExcepciones() :
{
    Token t;
    Nodo n = new Nodo("manejoExcepciones");
    Nodo cuerpo;
    Nodo captura;
    boolean tieneCatch = false;
    boolean tieneFinally = false;
}
{
    t=<TRY> { mostrarToken(t); }

    cuerpo=bloque() {
        n.agregar(cuerpo);
    }

    (
        captura=clausulaCatch() {
            n.agregar(captura);
            tieneCatch = true;
        }
    )*

    [
        t=<FINALLY> {
            mostrarToken(t);
            tieneFinally = true;
            n.atributo("tieneFinally", "true");
        }

        cuerpo=bloque() {
            n.agregar(cuerpo);
        }
    ]

    {
        if (!tieneCatch && !tieneFinally) {
            throw new ParseException(
                "Un bloque try debe tener catch o finally."
            );
        }

        return n;
    }
}

Nodo clausulaCatch() :
{
    Token t;
    Nodo n = new Nodo("clausulaCatch");
    Nodo cuerpo;
    String tipoExcepcion = "";
    String variableExcepcion = "";
}
{
    t=<CATCH> { mostrarToken(t); }

    [
        t=<PARENTESIS_IZQ> { mostrarToken(t); }

        t=<IDENTIFICADOR> {
            mostrarToken(t);
            tipoExcepcion = t.image;
        }

        [
            t=<IDENTIFICADOR> {
                mostrarToken(t);
                variableExcepcion = t.image;
            }
        ]

        t=<PARENTESIS_DER> { mostrarToken(t); }
    ]

    {
        if (!tipoExcepcion.isEmpty()) {
            n.atributo("tipoExcepcion", tipoExcepcion);
        }

        if (!variableExcepcion.isEmpty()) {
            n.atributo("variableExcepcion", variableExcepcion);
        }
    }

    cuerpo=bloque() {
        n.agregar(cuerpo);
        return n;
    }
}

// ------------------------------------------------------
// LANZAMIENTO DE EXCEPCIONES: THROW
// ------------------------------------------------------
Nodo throwInstruccion() :
{
    Token t;
    Nodo n = new Nodo("throwInstruccion");
    Nodo exp;
}
{
    t=<THROW> { mostrarToken(t); }

    [
        exp=expresion() {
            n.agregar(exp);
        }
    ]

    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    { return n; }
}

// ------------------------------------------------------
// WHILE
// ------------------------------------------------------
Nodo cicloMientras() :
{ Token t; Nodo n = new Nodo("cicloMientras"); Nodo cond, cuerpo; }
{
    { regla("cicloMientras -> while ( expresionLogica ) bloque"); }
    t=<WHILE> { mostrarToken(t); }
    t=<PARENTESIS_IZQ> { mostrarToken(t); }
    cond=expresionLogica() { n.agregar(cond); }
    t=<PARENTESIS_DER> { mostrarToken(t); }
    cuerpo=bloque() { n.agregar(cuerpo); return n; }
}

// ------------------------------------------------------
// DO-WHILE
// ------------------------------------------------------
Nodo cicloDoWhile() :
{ Token t; Nodo n = new Nodo("cicloDoWhile"); Nodo cuerpo, cond; }
{
    { regla("cicloDoWhile -> do bloque while ( expresionLogica ) puntocoma"); }
    t=<DO> { mostrarToken(t); }
    cuerpo=bloque() { n.agregar(cuerpo); }
    t=<WHILE> { mostrarToken(t); }
    t=<PARENTESIS_IZQ> { mostrarToken(t); }
    cond=expresionLogica() { n.agregar(cond); }
    t=<PARENTESIS_DER> { mostrarToken(t); }
    t=<PUNTO_Y_COMA> { mostrarToken(t); return n; }
}

// ------------------------------------------------------
// FOREACH
// ------------------------------------------------------
Nodo cicloForeach() :
{ Token t; Nodo n = new Nodo("cicloForeach"); Nodo cuerpo; }
{
    { regla("cicloForeach -> foreach ( tipo identificador in coleccion ) bloque"); }
    t=<FOREACH> { mostrarToken(t); }
    t=<PARENTESIS_IZQ> { mostrarToken(t); }
    (
          t=<INT>     { mostrarToken(t); n.atributo("tipoDato", "int"); }
        | t=<STRING>  { mostrarToken(t); n.atributo("tipoDato", "string"); }
        | t=<BOOL>    { mostrarToken(t); n.atributo("tipoDato", "bool"); }
        | t=<BOOLEAN> { mostrarToken(t); n.atributo("tipoDato", "boolean"); }
    )
    t=<IDENTIFICADOR> { mostrarToken(t); n.valor = t.image; }
    t=<IN> { mostrarToken(t); }
    t=<IDENTIFICADOR> { mostrarToken(t); n.atributo("coleccion", t.image); }
    t=<PARENTESIS_DER> { mostrarToken(t); }
    cuerpo=bloque() { n.agregar(cuerpo); return n; }
}

// ------------------------------------------------------
// SWITCH
// ------------------------------------------------------
Nodo estructuraSwitch() :
{ Token t; Nodo n = new Nodo("estructuraSwitch"); Nodo exp, caso; }
{
    { regla("switch -> switch ( expresion ) { casos+ default? }"); }
    t=<SWITCH> { mostrarToken(t); }
    t=<PARENTESIS_IZQ> { mostrarToken(t); }
    exp=expresion() { n.agregar(exp); }
    t=<PARENTESIS_DER> { mostrarToken(t); }
    t=<LLAVE_IZQ> { mostrarToken(t); }
    ( caso=casoSwitch() { n.agregar(caso); } )+
    [ caso=casoDefaultSwitch() { n.agregar(caso); } ]
    t=<LLAVE_DER> { mostrarToken(t); return n; }
}

Nodo casoSwitch() :
{ Token t; Nodo n = new Nodo("casoSwitch"); Nodo val, inst; }
{
    { regla("caso -> case valor : instrucciones"); }
    t=<CASE> { mostrarToken(t); }
    val=valor() { n.agregar(val); }
    t=<DOS_PUNTOS> { mostrarToken(t); }
    ( inst=instruccion() { n.agregar(inst); } )*
    { return n; }
}

Nodo casoDefaultSwitch() :
{ Token t; Nodo n = new Nodo("casoDefault"); Nodo inst; }
{
    { regla("default -> default : instrucciones"); }
    t=<DEFAULT_KW> { mostrarToken(t); }
    t=<DOS_PUNTOS> { mostrarToken(t); }
    ( inst=instruccion() { n.agregar(inst); } )*
    { return n; }
}

// ------------------------------------------------------
// BREAK, CONTINUE, RETURN
// ------------------------------------------------------
Nodo breakInstruccion() :
{ Token t; }
{
    { regla("break -> break puntocoma"); }
    t=<BREAK> { mostrarToken(t); }
    t=<PUNTO_Y_COMA> { mostrarToken(t); return new Nodo("breakInstruccion"); }
}

Nodo continueInstruccion() :
{ Token t; }
{
    { regla("continue -> continue puntocoma"); }
    t=<CONTINUE> { mostrarToken(t); }
    t=<PUNTO_Y_COMA> { mostrarToken(t); return new Nodo("continueInstruccion"); }
}

Nodo returnInstruccion() :
{ Token t; Nodo n = new Nodo("returnInstruccion"); Nodo exp; }
{
    { regla("return -> return (expresion)? puntocoma"); }
    t=<RETURN> { mostrarToken(t); }
    [ exp=expresion() { n.agregar(exp); } ]
    t=<PUNTO_Y_COMA> { mostrarToken(t); return n; }
}

// ------------------------------------------------------
// FOR
// ------------------------------------------------------
Nodo cicloPara() :
{
    Token t;
    Nodo n = new Nodo("cicloPara");
    Nodo init, cond, upd, cuerpo;
}
{
    { regla("cicloPara -> for ( inicializacion ; condicion ; actualizacion ) bloque"); }

    t=<FOR> { mostrarToken(t); }
    t=<PARENTESIS_IZQ> { mostrarToken(t); }

    (
        LOOKAHEAD(<PUNTO_Y_COMA>)
        { n.agregar(new Nodo("sinInicializacion")); }

      |
        LOOKAHEAD(2)
        init=declaracionVariableFor() { n.agregar(init); }

      |
        init=asignacionSimple() { n.agregar(init); }
    )

    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    cond=expresionLogica() { n.agregar(cond); }

    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    upd=asignacionSimple() { n.agregar(upd); }

    t=<PARENTESIS_DER> { mostrarToken(t); }

    cuerpo=bloque() { n.agregar(cuerpo); }

    { return n; }
}

Nodo asignacionSimple() :
{ Token t; Nodo n = new Nodo("asignacionSimple"); Nodo exp; }
{
    t=<IDENTIFICADOR> {
        mostrarToken(t);
        n.valor = t.image;
    }

    (
        (
            t=<ASIGNACION> {
                mostrarToken(t);
                n.atributo("operadorAsignacion", "=");
            }
          |
            t=<SUMA_ASIGNACION> {
                mostrarToken(t);
                n.atributo("operadorAsignacion", "+=");
            }
          |
            t=<RESTA_ASIGNACION> {
                mostrarToken(t);
                n.atributo("operadorAsignacion", "-=");
            }
        )
        exp=expresion() {
            n.agregar(exp);
        }

      |
        t=<INCREMENTO> {
            mostrarToken(t);
            n.atributo("operadorAsignacion", "++");
        }

      |
        t=<DECREMENTO> {
            mostrarToken(t);
            n.atributo("operadorAsignacion", "--");
        }
    )

    { return n; }
}

// ------------------------------------------------------
// PRINT
// ------------------------------------------------------
Nodo escritura() :
{ Token t; Nodo n = new Nodo("escritura"); Nodo exp; }
{
    (
          (
              t=<PRINT>   { mostrarToken(t); n.atributo("variante", "print"); }
            | t=<PRINTLN> { mostrarToken(t); n.atributo("variante", "println"); }
          )
          t=<PARENTESIS_IZQ> { mostrarToken(t); }
          exp=expresion() { n.agregar(exp); }
          t=<PARENTESIS_DER> { mostrarToken(t); }
          t=<PUNTO_Y_COMA> { mostrarToken(t); }

        |

          t=<CONSOLE> { mostrarToken(t); }
          t=<PUNTO> { mostrarToken(t); }
          t=<WRITELINE> { mostrarToken(t); n.atributo("variante", "WriteLine"); }
          t=<PARENTESIS_IZQ> { mostrarToken(t); }
          exp=expresion() { n.agregar(exp); }
          t=<PARENTESIS_DER> { mostrarToken(t); }
          t=<PUNTO_Y_COMA> { mostrarToken(t); }
    )
    { return n; }
}

// ------------------------------------------------------
// BLOQUE
// ------------------------------------------------------
Nodo bloque() :
{ Token t; Nodo n = new Nodo("bloque"); Nodo inst; }
{
    { regla("bloque -> { instrucciones* }"); }
    t=<LLAVE_IZQ> { mostrarToken(t); }
    ( inst=instruccion() { n.agregar(inst); } )*
    t=<LLAVE_DER> { mostrarToken(t); return n; }
}

// ------------------------------------------------------
// EXPRESIONES LOGICAS
// ------------------------------------------------------

Nodo expresionLogica() :
{ Nodo n; }
{
    n=expresionOr()
    { return n; }
}

Nodo expresionOr() :
{ Nodo izquierdo, derecho, n; Token t; }
{
    izquierdo=expresionAnd()
    (
        t=<OR_LOGICO> {
            mostrarToken(t);
        }
        derecho=expresionAnd() {
            n = new Nodo("expresionLogica");
            n.atributo("operador", "||");
            n.agregar(izquierdo);
            n.agregar(derecho);
            izquierdo = n;
        }
    )*
    { return izquierdo; }
}

Nodo expresionAnd() :
{ Nodo izquierdo, derecho, n; Token t; }
{
    izquierdo=expresionNot()
    (
        t=<AND_LOGICO> {
            mostrarToken(t);
        }
        derecho=expresionNot() {
            n = new Nodo("expresionLogica");
            n.atributo("operador", "&&");
            n.agregar(izquierdo);
            n.agregar(derecho);
            izquierdo = n;
        }
    )*
    { return izquierdo; }
}

Nodo expresionNot() :
{ Nodo n; Token t; Nodo resultado; }
{
      t=<NOT_LOGICO> {
          mostrarToken(t);
      }
      n=expresionNot() {
          resultado = new Nodo("expresionLogica");
          resultado.atributo("operador", "!");
          resultado.agregar(n);
          return resultado;
      }

    | t=<PARENTESIS_IZQ> {
          mostrarToken(t);
      }
      n=expresionLogica() {
      }
      t=<PARENTESIS_DER> {
          mostrarToken(t);
      }
      {
          resultado = new Nodo("agrupacion");
          resultado.agregar(n);
          return resultado;
      }

    | n=expresionRelacional() {
          return n;
      }
}

Nodo expresionRelacional() :
{ Nodo izquierdo, derecho, n; String op; }
{
    izquierdo=expresion()
    [
        op=operadorRelacional()
        derecho=expresion() {
            n = new Nodo("expresionLogica");
            n.atributo("operador", op);
            n.agregar(izquierdo);
            n.agregar(derecho);
            return n;
        }
    ]
    {
        return izquierdo;
    }
}

String operadorRelacional() :
{ Token t; }
{
      t=<MENOR>        { mostrarToken(t); return "<"; }
    | t=<MAYOR>         { mostrarToken(t); return ">"; }
    | t=<MENOR_IGUAL>   { mostrarToken(t); return "<="; }
    | t=<MAYOR_IGUAL>   { mostrarToken(t); return ">="; }
    | t=<IGUALDAD>      { mostrarToken(t); return "=="; }
    | t=<DIFERENTE>     { mostrarToken(t); return "!="; }
}

// ------------------------------------------------------
// EXPRESIONES ARITMETICAS
// ------------------------------------------------------

Nodo expresion() :
{ Nodo n; }
{
    n=expresionAditiva()
    { return n; }
}

Nodo expresionAditiva() :
{ Nodo izquierdo, derecho, n; String op; }
{
    izquierdo=expresionMultiplicativa()
    (
        op=operadorSumaResta()
        derecho=expresionMultiplicativa() {
            n = new Nodo("expresion");
            n.atributo("operador", op);
            n.agregar(izquierdo);
            n.agregar(derecho);
            izquierdo = n;

            regla("expresion -> " + op);
        }
    )*
    { return izquierdo; }
}

Nodo expresionMultiplicativa() :
{ Nodo izquierdo, derecho, n; String op; }
{
    izquierdo=expresionUnaria()
    (
        op=operadorMultiplicativo()
        derecho=expresionUnaria() {
            n = new Nodo("expresion");
            n.atributo("operador", op);
            n.agregar(izquierdo);
            n.agregar(derecho);
            izquierdo = n;

            regla("expresion -> " + op);
        }
    )*
    { return izquierdo; }
}

Nodo expresionUnaria() :
{ Nodo n; Token t; }
{
      t=<RESTA> {
          mostrarToken(t);
      }
      n=expresionUnaria() {
          Nodo resultado = new Nodo("expresion");
          resultado.atributo("operador", "unario-");
          resultado.agregar(n);
          return resultado;
      }

    | n=expresionPrimaria() {
          return n;
      }
}

Nodo llamadaFuncion() :
{ 
    Token t;
    Nodo n = new Nodo("llamadaFuncion");
    Nodo argumento;
}
{
    t=<IDENTIFICADOR> {
        mostrarToken(t);
        n.valor = t.image;
    }

    t=<PARENTESIS_IZQ> { mostrarToken(t); }

    [
        argumento=expresion() {
            n.agregar(argumento);
        }

        (
            t=<COMA> { mostrarToken(t); }
            argumento=expresion() {
                n.agregar(argumento);
            }
        )*
    ]

    t=<PARENTESIS_DER> { mostrarToken(t); }

    { return n; }
}

Nodo nuevoArreglo() :
{
    Token t;
    Nodo n;
}
{
    t=<NEW> { mostrarToken(t); }

    (
          t=<INT>     { mostrarToken(t); }
        | t=<BOOLEAN> { mostrarToken(t); }
        | t=<STRING>  { mostrarToken(t); }
        | t=<CHAR>    { mostrarToken(t); }
        | t=<DOUBLE>  { mostrarToken(t); }
        | t=<FLOAT>   { mostrarToken(t); }
        | t=<LONG>    { mostrarToken(t); }
        | t=<SHORT>   { mostrarToken(t); }
        | t=<BYTE>    { mostrarToken(t); }
    )

    t=<CORCHETE_IZQ> { mostrarToken(t); }
    t=<CORCHETE_DER> { mostrarToken(t); }

    n=inicializadorArreglo()

    {
        return n;
    }
}

Nodo inicializadorArreglo() :
{
    Token t;
    Nodo n = new Nodo("arreglo");
    Nodo elemento;
}
{
    t=<LLAVE_IZQ> { mostrarToken(t); }

    [
        elemento=expresion() {
            n.agregar(elemento);
        }

        (
            t=<COMA> { mostrarToken(t); }

            elemento=expresion() {
                n.agregar(elemento);
            }
        )*
    ]

    t=<LLAVE_DER> { mostrarToken(t); }

    { return n; }
}

Nodo operacionArreglo() :
{
    Token t;
    String operacion;
    Nodo n = new Nodo("operacionArreglo");
}
{
    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        if (!"Array".equals(t.image)) {
            throw new ParseException(
                "Se esperaba Array para una operacion de arreglo."
            );
        }
    }

    t=<PUNTO> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        operacion = t.image;

        if (!"Sort".equals(operacion)
                && !"Reverse".equals(operacion)) {
            throw new ParseException(
                "Operacion de arreglo no soportada: " + operacion
            );
        }

        n.atributo("operacion", operacion);
    }

    t=<PARENTESIS_IZQ> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        n.valor = t.image;
    }

    t=<PARENTESIS_DER> { mostrarToken(t); }

    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    { return n; }
}

Nodo busquedaIndiceArreglo() :
{
    Token t;
    Nodo n = new Nodo("busquedaIndiceArreglo");
    Nodo elemento;
}
{
    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        if (!"Array".equals(t.image)) {
            throw new ParseException("Se esperaba Array.");
        }
    }

    t=<PUNTO> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        if (!"IndexOf".equals(t.image)) {
            throw new ParseException(
                "Se esperaba Array.IndexOf."
            );
        }
    }

    t=<PARENTESIS_IZQ> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        n.valor = t.image;
    }

    t=<COMA> { mostrarToken(t); }

    elemento=expresion()
    {
        n.agregar(elemento);
    }

    t=<PARENTESIS_DER> { mostrarToken(t); }

    { return n; }
}

Nodo copiarArreglo() :
{
    Token t;
    Nodo n = new Nodo("copiarArreglo");
    Nodo cantidad;
}
{
    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        if (!"Array".equals(t.image)) {
            throw new ParseException("Se esperaba Array.");
        }
    }

    t=<PUNTO> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        if (!"Copy".equals(t.image)) {
            throw new ParseException(
                "Se esperaba Array.Copy."
            );
        }
    }

    t=<PARENTESIS_IZQ> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        n.atributo("origen", t.image);
    }

    t=<COMA> { mostrarToken(t); }

    t=<IDENTIFICADOR>
    {
        mostrarToken(t);
        n.atributo("destino", t.image);
    }

    t=<COMA> { mostrarToken(t); }

    cantidad=expresion()
    {
        n.agregar(cantidad);
    }

    t=<PARENTESIS_DER> { mostrarToken(t); }
    t=<PUNTO_Y_COMA> { mostrarToken(t); }

    { return n; }
}

Nodo expresionPrimaria() :
{ Nodo n; Token t; }
{
    LOOKAHEAD(4) n=busquedaIndiceArreglo() { return n; }
    | LOOKAHEAD(2) n=llamadaFuncion() { return n; }
      { return n; }

    | t=<CONSOLE> {
          mostrarToken(t);
      }
      t=<PUNTO> {
          mostrarToken(t);
      }
      t=<READLINE> {
          mostrarToken(t);
      }
      t=<PARENTESIS_IZQ> {
          mostrarToken(t);
      }
      t=<PARENTESIS_DER> {
          mostrarToken(t);
      }
      {
          return new Nodo("lecturaConsola");
      }

    | n=nuevoArreglo()
      { return n; }

    | n=inicializadorArreglo()
      { return n; }

    | n=valor()
      { return n; }

    | t=<PARENTESIS_IZQ> {
          mostrarToken(t);
      }
      n=expresion() {
      }
      t=<PARENTESIS_DER> {
          mostrarToken(t);
      }
      {
          Nodo resultado = new Nodo("agrupacion");
          resultado.agregar(n);
          return resultado;
      }
}

String operadorSumaResta() :
{ Token t; }
{
      t=<SUMA>  { mostrarToken(t); return "+"; }
    | t=<RESTA> { mostrarToken(t); return "-"; }
}

String operadorMultiplicativo() :
{ Token t; }
{
      t=<MULT> { mostrarToken(t); return "*"; }
    | t=<DIV>  { mostrarToken(t); return "/"; }
    | t=<MOD>  { mostrarToken(t); return "%"; }
}

String operadorAritmetico() :
{ Token t; }
{
      t=<SUMA>  { mostrarToken(t); return "+"; }
    | t=<RESTA> { mostrarToken(t); return "-"; }
    | t=<MULT>  { mostrarToken(t); return "*"; }
    | t=<DIV>   { mostrarToken(t); return "/"; }
    | t=<MOD>   { mostrarToken(t); return "%"; }
}

Nodo valor() :
{
    Token t;
    Nodo n;
    Nodo indice;
}
{
      t=<IDENTIFICADOR> { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "identificador"); }

      [
          t=<CORCHETE_IZQ> { mostrarToken(t); }

          indice=expresion()

          t=<CORCHETE_DER> { mostrarToken(t); }

          {
              Nodo acceso = new Nodo("accesoArreglo", n.valor);
              acceso.agregar(indice);
              n = acceso;
          }

        |

          t=<PUNTO> { mostrarToken(t); }

          t=<IDENTIFICADOR> {
              mostrarToken(t);

              if (!"Length".equals(t.image)) {
                  throw new ParseException(
                      "Solo se admite la propiedad Length en esta version."
                  );
              }

              n = new Nodo("propiedadArreglo", n.valor);
          }
      ]
      { return n; }
    | t=<NUMERO>    { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "numero"); return n; }
    | t=<DECIMAL>   { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "decimal"); return n; }
    | t=<CADENA>    { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "cadena"); return n; }
    | t=<TRUE>      { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "true"); return n; }
    | t=<FALSE>     { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "false"); return n; }
    | t=<NULL>      { mostrarToken(t); n = new Nodo("valor", t.image); n.atributo("tipoValor", "null"); return n; }
}
